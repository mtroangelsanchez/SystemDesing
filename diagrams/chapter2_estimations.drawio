        <mxCell id="p1" value="2¹⁰ = 1 KB (Kilobyte)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=9;" vertex="1" parent="1">
